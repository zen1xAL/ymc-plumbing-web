# Server configuration
PORT=3000

# Slack Webhook URL (Optional for local testing, gracefully logs to console if empty)
# Format: https://hooks.slack.com/services/YOUR_WORKSPACE/YOUR_BOT/YOUR_TOKEN
SLACK_WEBHOOK_URL=

# Google Sheets Webhook URL / Apps Script Web App URL (Optional for local testing)
# Format: https://script.google.com/macros/s/AKfycbx.../exec
GOOGLE_SHEETS_WEBHOOK_URL=
